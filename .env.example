EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# HDGElabs calls API (the website backend that mints team-member accounts,
# returns company branding, and signs Storage uploads).
EXPO_PUBLIC_HDGE_API_URL=https://api.calls.hdgelabs.com

