{
  "expo": {
    "name": "HDGEcalls",
    "slug": "calling",
    "version": "0.3.2",
    "orientation": "portrait",
    "scheme": "hdgecalls",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash.png",
      "backgroundColor": "#C8E841",
      "resizeMode": "contain"
    },
    "android": {
      "package": "com.hdgelabs.hdgecalls",
      "versionCode": 5,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#C8E841"
      },
      "permissions": [
        "READ_CALL_LOG",
        "READ_CONTACTS",
        "READ_MEDIA_AUDIO",
        "READ_EXTERNAL_STORAGE",
        "POST_NOTIFICATIONS",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_DATA_SYNC",
        "WAKE_LOCK",
        "INTERNET",
        "ACCESS_NETWORK_STATE",
        "REQUEST_IGNORE_BATTERY_OPTIMIZATIONS"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "category": [
            "DEFAULT",
            "BROWSABLE"
          ],
          "data": [
            {
              "scheme": "hdgecalls"
            }
          ]
        }
      ]
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 35,
            "targetSdkVersion": 35,
            "minSdkVersion": 26
          }
        }
      ],
      "expo-notifications",
      [
        "expo-share-intent",
        {
          "androidIntentFilters": ["*/*"],
          "androidMainActivityAttributes": {
            "android:launchMode": "singleTask"
          },
          "disableIOS": true
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "updates": {
      "enabled": true,
      "url": "https://u.expo.dev/5cd6fe38-fa9f-49bb-81af-d43a93fec2cf",
      "fallbackToCacheTimeout": 0,
      "checkAutomatically": "ON_LOAD",
      "requestHeaders": {
        "expo-channel-name": "production"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "5cd6fe38-fa9f-49bb-81af-d43a93fec2cf"
      }
    }
  }
}
