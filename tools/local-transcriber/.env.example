# Local transcriber config. NEVER commit the real .env.
#
# Two backends — pick one per worker. You can run both in separate terminals
# (different folders, different HEALTH_PORT) to A/B compare against the same
# Supabase queue, but only one should poll at a time or they'll race.
#
#   sarvam  — Sarvam Saarika v2.5 API. Production diarization + Hinglish
#             ASR. ~$0.006-0.008/min. USE FOR CUSTOMER DEMO.
#   whisper — whisper.cpp large-v3-turbo on Metal/CPU. Free, ~5x realtime on
#             M3, no diarization. USE FOR DEV / OFFLINE.
TRANSCRIPTION_BACKEND=sarvam

# Supabase service-role key. Get from Supabase Studio → Settings → API.
# SECRET — never commit. Rotate if leaked.
SUPABASE_URL=https://fealhmelnwpaizmxrtnb.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# ---------- Sarvam (when TRANSCRIPTION_BACKEND=sarvam) ----------
# Get key from https://dashboard.sarvam.ai → API keys.
SARVAM_API_KEY=
SARVAM_MODEL=saarika:v2.5
# 'unknown' = auto-detect per request (best for mixed Hi/Mr/En).
SARVAM_LANGUAGE=unknown
SARVAM_WITH_DIARIZATION=1
# Optional speaker-count hint (2 for a 1-on-1 sales call).
# SARVAM_NUM_SPEAKERS=2

# ---------- Whisper (when TRANSCRIPTION_BACKEND=whisper) ----------
WHISPER_CLI=/opt/homebrew/bin/whisper-cli
WHISPER_MODEL=./models/ggml-large-v3-turbo-q5_0.bin
# 'hi' biases the model toward Hindi-script Devanagari + English code-switch.
# Use 'en' for English-only or 'auto' if you don't know.
WHISPER_LANGUAGE=hi
# --no-gpu sidesteps the ggml-metal 1.8.6 residency-set assertion that
# crashes Metal cleanup. CPU on M3 with turbo q5_0 is still ~3x realtime.
WHISPER_EXTRA_ARGS=--threads,8,--no-gpu,--max-context,0
# Transliterate Devanagari spans in whisper output to Roman ITRANS
# ("haan, theek hai"). English code-switches pass through unchanged.
ROMANIZE_HINDI=1

# ---------- Gemini cleanup (optional, both backends) ----------
# Post-ASR pass that fixes hallucinated phrases and mangled tech terms
# ("Pigma" -> "Figma", "Three March" -> "three months"). Free tier of
# gemini-2.5-flash covers >>5000 min/month.
# Get a key at https://aistudio.google.com/apikey
LLM_CLEANUP=1
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT_MS=90000

# ---------- Worker plumbing ----------
POLL_INTERVAL_SEC=10
POLL_INTERVAL_ACTIVE_SEC=3
BATCH_SIZE=2
STUCK_PROCESSING_SEC=600
HEALTH_PORT=7777
FFMPEG=/opt/homebrew/bin/ffmpeg
