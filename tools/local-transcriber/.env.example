# Local transcriber config. NEVER commit the real .env.
#
# Three backends:
#   indic   — AI4Bharat IndicConformer-600M via a Python sidecar (default).
#             Self-host, MIT, ~5x faster than realtime on M3, native
#             Marathi/Hindi/English. Free forever.
#   sarvam  — Sarvam Saarika v2.5 API (paid, includes diarization).
#             Fallback when indic is unavailable or diarization is required.
#   whisper — whisper.cpp + ggml on Metal. Kept for non-Indic workloads.
TRANSCRIPTION_BACKEND=indic

# HuggingFace read token — required for the first download of the gated
# AI4Bharat repo. Set after agreeing on
#   https://huggingface.co/ai4bharat/indic-conformer-600m-multilingual
# After the model is cached, the worker runs offline (HF_HUB_OFFLINE=1).
HF_TOKEN=

# ---------- Indic (when TRANSCRIPTION_BACKEND=indic) ----------
# Python venv created by:
#   python3.12 -m venv .venv-indic
#   source .venv-indic/bin/activate
#   pip install -r python/requirements.txt
INDIC_PYTHON_BIN=.venv-indic/bin/python
INDIC_CONFORMER_MODEL=ai4bharat/indic-conformer-600m-multilingual
# Marathi (mr), Hindi (hi), Bengali (bn), Tamil (ta), Telugu (te), Gujarati
# (gu), Kannada (kn), Punjabi (pa), Malayalam (ml), Oriya (or), Urdu (ur),
# Assamese (as), Sanskrit (sa), and others — 22 IN langs total.
INDIC_LANGUAGE=mr
# ctc = fast greedy decode (best speed). rnnt = autoregressive (slower,
# sometimes slightly higher accuracy on long-form audio).
INDIC_DECODER=ctc

# Get these from Supabase Studio → Settings → API.
SUPABASE_URL=https://fealhmelnwpaizmxrtnb.supabase.co
# Use a SECRET key (sb_secret_...) — required for RLS bypass.
# Rotate it if it ever leaks. Never paste it into chat.
SUPABASE_SERVICE_ROLE_KEY=

# ---------- Sarvam (when TRANSCRIPTION_BACKEND=sarvam) ----------
# Get from https://dashboard.sarvam.ai → API keys.
SARVAM_API_KEY=
SARVAM_MODEL=saarika:v2.5
# 'unknown' = auto-detect per request (best for mixed Hi/Mr/En).
# Force a code like hi-IN / mr-IN / en-IN for uniform-language workloads.
SARVAM_LANGUAGE=unknown
SARVAM_WITH_DIARIZATION=1
# Optional hint when speaker count is known (e.g. 2 for a 1-on-1 sales call).
# SARVAM_NUM_SPEAKERS=2

# ---------- whisper.cpp (when TRANSCRIPTION_BACKEND=whisper) ----------

# Path to whisper-cli binary. `brew install whisper-cpp` puts it at
# /opt/homebrew/bin/whisper-cli on Apple Silicon.
WHISPER_CLI=/opt/homebrew/bin/whisper-cli

# Path to the GGML model file (download once, see README).
# Default is large-v3-turbo q5_0 — multilingual incl. Hindi+English code-switch,
# ~574 MB on disk, ~5x realtime on M3 with Metal.
WHISPER_MODEL=./models/ggml-large-v3-turbo-q5_0.bin

# Whisper language. 'hi' is the right default for Indian B2B Hinglish calls.
# Whisper outputs Hindi in Devanagari and English in Roman; the worker then
# transliterates the Devanagari spans to Roman (see ROMANIZE_HINDI below) so
# the dashboard shows "haan, theek hai" instead of "हाँ ठीक है".
# Using 'en' drops Hindi segments entirely; 'auto' mis-detects to Icelandic.
WHISPER_LANGUAGE=hi

# Romanize any Devanagari produced by Whisper into Latin script (ITRANS-style,
# cleaned). Set to 0 to keep Hindi in Devanagari instead.
ROMANIZE_HINDI=1

# Comma-separated extra args passed to whisper-cli.
#   --threads 8         use all M3 perf cores
#   --flash-attn        faster + lower memory
#   --max-context 0     don't condition on prior segments (kills loops)
#   --vad + --vad-model run Silero VAD ahead of the decoder so silence and
#                       hold-music are dropped before they can trigger
#                       hallucinations ("kar apan kar apan kar apan…")
WHISPER_EXTRA_ARGS=--threads,8,--flash-attn,--max-context,0,--logprob-thold,-0.5,--entropy-thold,2.8,--vad,--vad-model,./models/ggml-silero-v5.1.2.bin,--vad-threshold,0.7,--vad-min-speech-duration-ms,500,--vad-min-silence-duration-ms,700

# Polling cadence. Adaptive: ACTIVE used right after a non-empty pass so a
# queued batch drains quickly; IDLE used otherwise to stay quiet.
POLL_INTERVAL_SEC=10
POLL_INTERVAL_ACTIVE_SEC=3

# How many calls to process per pass. Whisper is CPU/GPU bound — keep small.
BATCH_SIZE=2

# A row stuck in 'processing' longer than this gets bounced back to 'pending'
# (recovers from worker crashes). 600 = 10 min.
STUCK_PROCESSING_SEC=600

# Health-check HTTP port. Cloudflare Tunnel maps
# transcribe.calls.hdgelabs.com -> http://localhost:7777.
# Set to 0 to disable the HTTP server entirely.
HEALTH_PORT=7777

# ffmpeg path. `brew install ffmpeg`.
FFMPEG=/opt/homebrew/bin/ffmpeg
