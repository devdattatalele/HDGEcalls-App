# Local transcriber config. NEVER commit the real .env.
#
# One default backend: AI4Bharat IndicConformer + IndicTrans2 (self-host,
# MIT). Whisper.cpp is kept as an opt-in fallback for English-only workloads.
TRANSCRIPTION_BACKEND=indic

# HuggingFace read token — required for the first download of the gated
# AI4Bharat IndicConformer repo. Set after agreeing on
#   https://huggingface.co/ai4bharat/indic-conformer-600m-multilingual
# After the model is cached, the daemon runs offline (HF_HUB_OFFLINE=1).
HF_TOKEN=

# Supabase service-role key for the worker. Get from Supabase Studio →
# Settings → API. SECRET — never commit. Rotate if leaked.
SUPABASE_URL=https://fealhmelnwpaizmxrtnb.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# ---------- Indic (default) ----------
# Python venv: python3.12 -m venv .venv-indic && pip install -r python/requirements.txt
INDIC_PYTHON_BIN=.venv-indic/bin/python

# Layer 1 — speech-to-text (Conformer + CTC). 22 Indian languages.
INDIC_CONFORMER_MODEL=ai4bharat/indic-conformer-600m-multilingual
# Language codes (used by both layers): mr, hi, bn, ta, te, gu, kn, pa,
# ml, or, ur, as, sa, ks, sd, ne, mai, kok, brx, doi, mni, sat.
INDIC_LANGUAGE=mr
# ctc = fast greedy decode. rnnt = autoregressive, slightly higher accuracy.
INDIC_DECODER=ctc

# Layer 2 — machine translation to English. Set to 0 to skip.
INDIC_TRANSLATE_TO_ENGLISH=1
INDIC_TRANS_MODEL=ai4bharat/indictrans2-indic-en-dist-200M
INDIC_TRANS_BEAM=5
INDIC_TRANS_MAX_LEN=512

# Output post-processing — transliterate Devanagari to Roman (ITRANS-style,
# cleaned). Set to 0 to keep the original script. Only affects Layer 1
# (Layer 2 is already in English, Layer 3 is already romanised).
ROMANIZE_HINDI=1

# Layer 3 — also run whisper.cpp in parallel to produce a code-switched
# "mixed" transcript that preserves English words ("meeting", "UI") which
# IndicConformer drops. Set to 0 to skip and run only the Indic pipeline.
INCLUDE_WHISPER_LAYER=1

# ---------- Whisper (opt-in fallback) ----------
# Only used when TRANSCRIPTION_BACKEND=whisper. Kept for English-only
# customers where IndicConformer's coverage isn't needed.
WHISPER_CLI=/opt/homebrew/bin/whisper-cli
WHISPER_MODEL=./models/ggml-large-v3-turbo-q5_0.bin
WHISPER_LANGUAGE=hi
# --no-gpu sidesteps a ggml-metal 1.8.6 residency-set assertion that
# crashes the Metal cleanup path when whisper-cli is spawned alongside the
# Indic daemon. CPU on M3 with turbo q5_0 is still ~3x realtime, which is
# fast enough for the parallel Layer 3 pass.
WHISPER_EXTRA_ARGS=--threads,8,--no-gpu,--max-context,0

# ---------- Worker plumbing ----------
POLL_INTERVAL_SEC=10
POLL_INTERVAL_ACTIVE_SEC=3
BATCH_SIZE=2
STUCK_PROCESSING_SEC=600
HEALTH_PORT=7777
FFMPEG=/opt/homebrew/bin/ffmpeg
