# Dev worker — AI4Bharat IndicConformer + IndicTrans2 + whisper.cpp Layer 3.
# Sibling of local-transcriber/ which runs the Sarvam-backed demo worker.
# Run only ONE of them at a time (they share the same Supabase queue).
TRANSCRIPTION_BACKEND=indic

# Supabase service-role — same keys as the Sarvam worker, both write to the
# same calls table.
SUPABASE_URL=https://fealhmelnwpaizmxrtnb.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# HuggingFace read token. The Sarvam worker's .env already has it; just
# copy that value here.
HF_TOKEN=

# ---------- Indic (AI4Bharat) ----------
INDIC_PYTHON_BIN=.venv-indic/bin/python
INDIC_CONFORMER_MODEL=ai4bharat/indic-conformer-600m-multilingual
# 22 IN langs: mr, hi, bn, ta, te, gu, kn, pa, ml, or, ur, as, sa, ks, sd,
# ne, mai, kok, brx, doi, mni, sat.
INDIC_LANGUAGE=mr
# ctc = fast greedy decode. rnnt = autoregressive, slightly higher accuracy.
INDIC_DECODER=ctc
# Long audio is chunked into 60s windows with 1.5s overlap because the
# Conformer ONNX export has no internal chunker (encoder positional
# embeddings overflow on long inputs).
INDIC_ASR_CHUNK_SEC=60
INDIC_ASR_CHUNK_OVERLAP_SEC=1.5

# Layer 2 — IndicTrans2 English translation.
INDIC_TRANSLATE_TO_ENGLISH=1
INDIC_TRANS_MODEL=ai4bharat/indictrans2-indic-en-dist-200M

# Layer 3 — whisper.cpp code-switch ("Mixed" tab) running in parallel.
# Set to 0 if the customer's calls are pure Indic.
INCLUDE_WHISPER_LAYER=1
WHISPER_CLI=/opt/homebrew/bin/whisper-cli
WHISPER_MODEL=./models/ggml-large-v3-turbo-q5_0.bin
WHISPER_LANGUAGE=hi
# --no-gpu sidesteps the ggml-metal 1.8.6 residency-set crash that happens
# during cleanup when whisper-cli is spawned in parallel with the daemon.
WHISPER_EXTRA_ARGS=--threads,8,--no-gpu,--max-context,0

# Output post-processing — transliterate Devanagari to Roman (ITRANS style).
ROMANIZE_HINDI=1

# ---------- Worker plumbing ----------
POLL_INTERVAL_SEC=10
POLL_INTERVAL_ACTIVE_SEC=3
BATCH_SIZE=2
STUCK_PROCESSING_SEC=600
# Different port from the Sarvam worker so both can run side-by-side if
# you ever want to (default Sarvam worker is on 7777).
HEALTH_PORT=7778
FFMPEG=/opt/homebrew/bin/ffmpeg
