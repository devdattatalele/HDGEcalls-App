# Dev worker — whisper.cpp large-v3-turbo on M3, no API costs.
# Sibling of local-transcriber/ which runs the Sarvam-backed demo worker.
# Same TypeScript code (src/ is a symlink), only the .env differs.
# Run only ONE of them at a time — they share the same Supabase queue.
TRANSCRIPTION_BACKEND=whisper

# Supabase service-role — same keys as the Sarvam worker, both write to the
# same calls table.
SUPABASE_URL=https://fealhmelnwpaizmxrtnb.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# ---------- Whisper ----------
WHISPER_CLI=/opt/homebrew/bin/whisper-cli
WHISPER_MODEL=./models/ggml-large-v3-turbo-q5_0.bin
# 'hi' biases toward Devanagari + English code-switch (the "mixed" mode that
# beat IndicConformer on tech terms in our 2026-06-05 comparison).
WHISPER_LANGUAGE=hi
# --no-gpu sidesteps the ggml-metal 1.8.6 residency-set assertion.
WHISPER_EXTRA_ARGS=--threads,8,--no-gpu,--max-context,0
# Transliterate Devanagari to Roman ITRANS ("haan, theek hai").
ROMANIZE_HINDI=1

# ---------- Gemini cleanup (optional, free tier) ----------
# Fixes whisper's hallucinations + mangled tech terms. Same Gemini key as the
# Sarvam worker — copy from ../local-transcriber/.env if you've already set it.
LLM_CLEANUP=1
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT_MS=90000

# ---------- Worker plumbing ----------
POLL_INTERVAL_SEC=10
POLL_INTERVAL_ACTIVE_SEC=3
BATCH_SIZE=2
STUCK_PROCESSING_SEC=600
# Different port from the Sarvam worker so both can boot (default 7777).
HEALTH_PORT=7778
FFMPEG=/opt/homebrew/bin/ffmpeg
